{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "src",
    "outDir": "js",
    "strict": true,
    "useUnknownInCatchVariables": false,
    "noEmitOnError": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["spotify-web-playback-sdk"]
  },
  "include": ["src"]
}
